UPSTREAM_URL=http://127.0.0.1:4000/
JWT_PUBLIC_KEY_FILE=/secure/location/jwt-public.pem
JWT_ISSUER=https://issuer.example.org
JWT_AUDIENCE=internal-api
ROUTE_RULES={"/api/data":["reader","admin"],"/api/admin":["admin"]}
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_BYTES=1048576
MAX_RESPONSE_BYTES=2097152
UPSTREAM_TIMEOUT_MS=5000
PORT=3000
